# Copia este arquivo para .env e troca os segredos.
# O .env fica só na sua máquina. O Docker Compose lê ele automaticamente.

POSTGRES_USER=marcaink
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=marcaink_development
# Porta do Postgres no computador. Dentro do Docker continua 5432.
DB_PORT=5433

API_PORT=3041
WEB_PORT=3042

JWT_SECRET=troque-este-segredo
CORS_ORIGINS=http://localhost:3042,http://127.0.0.1:3042
# Endereço da API visto pelo navegador. Mudou a porta? Rode de novo: docker compose up --build web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3041

# Deixe vazio para o billing ficar em modo demonstração.
ABACATEPAY_API_KEY=
ABACATEPAY_CHECKOUT_URL=

# Endereço do site usado no link de "esqueci minha senha".
WEB_ORIGIN=http://127.0.0.1:3042
# 1 mostra o link na tela quando o SMTP está vazio. Em produção, deixe vazio e preencha o SMTP.
ALLOW_PASSWORD_RESET_PREVIEW=1
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=MarcaInk <nao-responda@marcaink.app>
